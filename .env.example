# ============================================================
# Runtime
# ============================================================

WEEKEND_REPORT_IMAGE=weekend-report:local
WEEKEND_REPORT_APP_VERSION=<TBD>
WEEKEND_REPORT_BUILD_ID=<TBD>

WEEKEND_REPORT_CONFIG_DIR=/app/config
WEEKEND_REPORT_EVIDENCE_ROOT=/app/runs

# ============================================================
# Production authentication
#
# Supported providers:
#
# trusted_header
# local_login
# ============================================================

WEEKEND_REPORT_AUTH_MODE=production
WEEKEND_REPORT_AUTH_PROVIDER=<TBD>

# trusted_header only
WEEKEND_REPORT_AUTH_TRUSTED_HEADER=X-Authenticated-User

# Comma-separated identities.
WEEKEND_REPORT_AUTHORIZED_REVIEWERS=<TBD>


# ============================================================
# Browser CSRF
# ============================================================

WEEKEND_REPORT_CSRF_SIGNING_KEY=<TBD>
WEEKEND_REPORT_CSRF_TTL_SECONDS=3600


# ============================================================
# local_login only
# ============================================================

WEEKEND_REPORT_LOCAL_USERS_FILE=/app/secrets/local-users.json
WEEKEND_REPORT_SESSION_SIGNING_KEY=<TBD>
WEEKEND_REPORT_SESSION_TTL_SECONDS=14400


# ============================================================
# Secrets / integration runtime values
# ============================================================

POSTGRES_PASSWORD=<TBD>

PORTAINER_SITE1_URL=<TBD>
PORTAINER_SITE1_TOKEN=<TBD>
PORTAINER_SITE1_CA_FILE=<TBD>

PORTAINER_SITE2_URL=<TBD>
PORTAINER_SITE2_TOKEN=<TBD>
PORTAINER_SITE2_CA_FILE=<TBD>

SSH_PRIVATE_KEY_PATH=<TBD>
SSH_KNOWN_HOSTS_PATH=<TBD>

# ============================================================
# RabbitMQ
# ============================================================

RABBITMQ_SITE1_URL=<TBD>
RABBITMQ_SITE1_USER=<TBD>
RABBITMQ_SITE1_PASSWORD=<TBD>

RABBITMQ_SITE2_URL=<TBD>
RABBITMQ_SITE2_USER=<TBD>
RABBITMQ_SITE2_PASSWORD=<TBD>


# ============================================================
# Recording
# ============================================================

RECORDING_MANAGER_WEBAPP_URL=<TBD>

RECORDING_SITE1_WEBAPP_URL=<TBD>
RECORDING_SITE2_WEBAPP_URL=<TBD>
