# Database synchronization check
#
# Three logical database pairs are checked between Site 1 and Site 2.
# Each pair represents corresponding database servers in the two sites.

DATABASE_COLLECTION_MODE=live

DATABASE_PAIR_COUNT=3

DATABASE_PAIR_1_NAME=database1
DATABASE_PAIR_1_SITE1_HOST=<TBD>
DATABASE_PAIR_1_SITE2_HOST=<TBD>
DATABASE_PAIR_1_PORT=3306

DATABASE_PAIR_2_NAME=database2
DATABASE_PAIR_2_SITE1_HOST=<TBD>
DATABASE_PAIR_2_SITE2_HOST=<TBD>
DATABASE_PAIR_2_PORT=3306

DATABASE_PAIR_3_NAME=database3
DATABASE_PAIR_3_SITE1_HOST=<TBD>
DATABASE_PAIR_3_SITE2_HOST=<TBD>
DATABASE_PAIR_3_PORT=3306

DATABASE_USERNAME=<TBD>
DATABASE_PASSWORD_FILE=/app/secrets/database_sync_password