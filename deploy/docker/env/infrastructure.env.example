# Dynamic inventory: SITE_COUNT=N (N >= 1); this file shows two sample sites.
# Define SITE<N>_ID, SITE<N>_DISPLAY_NAME, SITE<N>_PURPOSE for N=1..SITE_COUNT.
# Per site: SITE<N>_SERVER_COUNT, then SITE<N>_SERVER_<M>_ID/HOST/PORT/REQUIRED.
# M runs from 1 through that site's server count. Remove blocks above either count.
# All module ENV numbering follows the same runtime site number; see CONFIGURATION.md.

# Site definitions, SSH identity paths, and server inventories.
# Mapper filesystems are discovered by df -h | grep mapper; no device inventory belongs here.
# The command and thresholds remain versioned in rules.yml.

SITE_COUNT=2

SITE1_ID=site1
SITE1_DISPLAY_NAME=<TBD>
SITE1_PURPOSE=weekend_report_site

SITE2_ID=site2
SITE2_DISPLAY_NAME=<TBD>
SITE2_PURPOSE=weekend_report_site

SSH_USERNAME=<TBD>
SSH_PRIVATE_KEY_PATH=<TBD>
SSH_KNOWN_HOSTS_PATH=<TBD>

CHRONY_TIMEZONE=<TBD>
CHRONY_SOURCE=<TBD>

SITE1_SERVER_COUNT=1
SITE1_SERVER_1_ID=<TBD>
SITE1_SERVER_1_HOST=<TBD>
SITE1_SERVER_1_PORT=22
SITE1_SERVER_1_REQUIRED=true

SITE2_SERVER_COUNT=1
SITE2_SERVER_1_ID=<TBD>
SITE2_SERVER_1_HOST=<TBD>
SITE2_SERVER_1_PORT=22
SITE2_SERVER_1_REQUIRED=true
