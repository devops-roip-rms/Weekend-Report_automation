# Dedicated CI image for the closed GitLab environment.
# Build this image on an Internet-connected machine, then transfer/tag/push it
# into the internal registry. It contains Python quality tools plus Docker CLI
# and Compose so GitLab jobs never need apt/apk/pip network access.
FROM docker:27.5.1-cli AS docker_cli

FROM python:3.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        gzip \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose \
    /usr/local/libexec/docker/cli-plugins/docker-compose

COPY requirements.txt requirements-dev.txt /tmp/

RUN python -m pip install --no-cache-dir -r /tmp/requirements-dev.txt \
    && python -m pip check

# Produce audit evidence while Internet access is available. The closed GitLab
# pipeline verifies these hashes/evidence instead of contacting package indexes.
RUN mkdir -p /usr/local/share/weekend-report-ci \
    && sha256sum /tmp/requirements.txt | cut -d ' ' -f 1 \
        > /usr/local/share/weekend-report-ci/requirements.sha256 \
    && sha256sum /tmp/requirements-dev.txt | cut -d ' ' -f 1 \
        > /usr/local/share/weekend-report-ci/requirements-dev.sha256 \
    && python -m pip_audit -r /tmp/requirements.txt \
        --format json \
        --output /usr/local/share/weekend-report-ci/pip-audit.json \
    && date -u +"%Y-%m-%dT%H:%M:%SZ" \
        > /usr/local/share/weekend-report-ci/pip-audit-passed-at

RUN test -s /usr/local/share/weekend-report-ci/requirements.sha256 \
    && test -s /usr/local/share/weekend-report-ci/requirements-dev.sha256 \
    && test -s /usr/local/share/weekend-report-ci/pip-audit.json \
    && test -s /usr/local/share/weekend-report-ci/pip-audit-passed-at \
    && python -c "import fastapi, starlette, uvicorn, jinja2, httpx, yaml, psycopg" \
    && python --version \
    && ruff --version \
    && mypy --version \
    && python -m pip_audit --version \
    && docker --version \
    && docker compose version \
    && gzip --version \
    && sha256sum --version

CMD ["python", "--version"]
