# Dedicated CI image for Weekend Report Automation.
#
# Build this image on an Internet-connected machine, then docker save/load it
# into the closed network and push it to the internal registry.
#
# Runtime/application Python dependencies remain controlled by requirements.txt.
# CI-only tools are installed explicitly below.

FROM docker:27.5.1-cli AS docker_cli

FROM python:3.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

# OS tools required by the project/CI.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Reuse the Docker 27 CLI and Compose plugin so the same CI image can also run
# `docker compose ...` validation without installing packages in GitLab.
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose \
    /usr/local/libexec/docker/cli-plugins/docker-compose

# Application/runtime dependencies are sourced only from the repository's
# requirements.txt so CI tests exactly the dependency set declared by the app.
COPY requirements.txt /tmp/requirements.txt

RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && python -m pip install --no-cache-dir \
        ruff \
        mypy \
        types-PyYAML \
        pip-audit \
        pytest \
        bandit \
    && python -m pip check

# Fail the image build immediately if required runtime libraries are missing.
RUN python -c "import fastapi, starlette, uvicorn, jinja2, httpx, yaml, psycopg"

# Verify the CI tools before exporting the image.
RUN python --version \
    && ruff --version \
    && mypy --version \
    && python -m pip_audit --version \
    && pytest --version \
    && bandit --version \
    && docker --version \
    && docker compose version

CMD ["python", "--version"]
