# Repository / CI metadata
.git
.github/
.gitlab-ci-cd/
.gitlab-ci.yml

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Local environment / editor state
.env
.env.*
.venv/
.idea/
.vscode/

# Runtime/deployment configuration is external to the application image.
deploy/
runs/
data/
work/

# Generated build / transfer artifacts
dist/
runtime-bundle/
wheelhouse/
weekend-report-runtime-base-*.tar
weekend-report-runtime-base-*.tar.gz
weekend-report-ci-*.tar
weekend-report-ci-*.tar.gz
weekend-report-runtime_*.tar
weekend-report-runtime_*.tar.gz
image-id.txt
release-image-id.txt

# Never send private key/certificate material into a Docker build context.
*.key
*.pem
*.crt
